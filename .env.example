# --- Base de donnees -------------------------------------------------------
POSTGRES_USER=backline
POSTGRES_PASSWORD=backline
POSTGRES_DB=backline

# --- Stockage objet (MinIO en local, S3-compatible en prod) ----------------
MINIO_ROOT_USER=backline
MINIO_ROOT_PASSWORD=backline-dev-secret
S3_BUCKET=backline
S3_REGION=us-east-1
# URL atteignable depuis le navigateur / la CLI de rendu
S3_PUBLIC_ENDPOINT=http://localhost:9100

# --- Application -----------------------------------------------------------
# Secret de signature des sessions et des jetons. A REGENERER en production.
SESSION_SECRET=dev-session-secret-change-me-in-production-please
PUBLIC_BASE_URL=http://localhost:8088
SITE_ADDRESS=:8088
RUST_LOG=info,backline=debug,sqlx=warn
# Donnees d'amorcage (§16) — laisser a 1 en local, 0 en production
RUN_SEED=1

# --- Telegram --------------------------------------------------------------
# Vide = bot desactive, l'application reste entierement utilisable via le web.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling

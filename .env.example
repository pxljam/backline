# --- Database ---------------------------------------------------------------
POSTGRES_USER=backline
POSTGRES_PASSWORD=backline
POSTGRES_DB=backline

# --- Object storage (MinIO locally, S3-compatible in prod) ------------------
MINIO_ROOT_USER=backline
MINIO_ROOT_PASSWORD=backline-dev-secret
S3_BUCKET=backline
S3_REGION=us-east-1
# URL reachable from the browser / the render CLI
S3_PUBLIC_ENDPOINT=http://localhost:9100

# --- Application -----------------------------------------------------------
# Signing secret for sessions and tokens. REGENERATE in production.
SESSION_SECRET=dev-session-secret-change-me-in-production-please
PUBLIC_BASE_URL=http://localhost:8088
SITE_ADDRESS=:8088
RUST_LOG=info,backline=debug,sqlx=warn
# Seed data (§16) — leave at 1 locally, 0 in production
RUN_SEED=1

# --- Telegram --------------------------------------------------------------
# Empty = bot disabled; the application stays fully usable through the web.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
